doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title + ' | Taskify'
    script(src="https://cdn.tailwindcss.com")
    link(href="https://fonts.googleapis.com/css2?family=Manrope:wght@700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet")
    link(href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet")
    style.
      body { font-family: 'Inter', sans-serif; }
      h1 { font-family: 'Manrope', sans-serif; }
      .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }

  body(class="bg-slate-50 text-slate-800 min-h-screen flex items-center justify-center")
    .text-center.p-8
      span(class="material-symbols-outlined text-7xl text-slate-300 mb-4") lock
      h1(class="text-4xl font-extrabold mb-2") 403
      p(class="text-slate-500 mb-6") You don't have permission to access this page.
      a(href="/dashboard" class="inline-flex items-center gap-2 bg-blue-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-blue-700 transition-colors")
        span(class="material-symbols-outlined text-sm") arrow_back
        | Back to Dashboard
