doctype html
html
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title= title
        link(rel="stylesheet" href="/css/main.css")

    body
        .container
            .auth-box
                h1.title Welcome back
                p.subtitle Log in to continue

                if error === 'invalid_credentials'
                    .error-message(style="margin-bottom: 16px; padding: 12px 14px; border-radius: 10px; background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; font-size: 14px;")
                        | Sai email hoặc mật khẩu

                form(method="POST" action="/login")
                    .form-group
                        label Email
                        input(type="email" name="email" placeholder="you@company.com" required)

                    .form-group
                        label Password
                        input(type="password" name="password" placeholder="Enter password" required)

                    button.btn(type="submit") Log in

                .divider
                    span Or continue with

                a.btn-google(href="/auth/google")
                    img(src="https://developers.google.com/identity/images/g-logo.png")
                    span Continue with Google

                p.switch
                    | Don't have an account? 
                    a(href="/sign-up") Sign up
