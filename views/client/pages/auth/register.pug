doctype html
html
    head
        title= title
    body
        h1 Register Pageeeeeeee

        form(method="POST" action="/register")
            div
                label Email
                input(type="email" name="email", required)

            div
                label Password
                input(type="password" name="password", required)

            button(type="submit") Register

        a(href="/login") Go to Login