doctype html
html
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title Home
        link(rel="stylesheet" href="/css/main.css")

    body
        .app
            // Sidebar
            aside.sidebar
                h2.logo Taskify

                ul.menu
                    li.active Dashboard
                    li Projects
                    li Teams
                    li Calendar
                    li Reports
                    li Settings

            // Main
            .main
                // Header
                include ../../partials/header
                header.header
                    h3 Hello, #{user.full_name}
                    input.search(type="text" placeholder="Search...")

                // Content
                .content
                    .top
                        h2 My Workspace
                        button.btn Create Project

                    .cards
                        .card.green
                            h3 Mobile App
                            p 4 members

                        .card.orange
                            h3 MEDAPP
                            p 6 members

                        .card.purple
                            h3 Website Redesign
                            p 2 members

                    .create-box
                        p + Create new project

                    .tasks
                        h3 Ongoing

                        .task
                            span API Documentation
                            .progress
                                div(style="width:75%")

                        .task
                            span Payment Security Check
                            .progress
                                div(style="width:30%")