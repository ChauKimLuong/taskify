doctype html
html
    head
        title= title
        style.
            body { font-family: Arial; margin: 0; display: flex; }
            .sidebar { width: 220px; background: #f4f5f7; padding: 20px; }
            .content { flex: 1; padding: 20px; }
            .header { background: #e9d8fd; padding: 20px; border-radius: 10px; }

    body
        .sidebar
            h3 Menu
            ul
                li Home
                li Tasks
                li Settings

        .content
            .header
                h2 Xin chào #{user.name}
                p Welcome to Taskify 🚀

            h3 Công việc của bạn
            p (Demo thôi 😄)