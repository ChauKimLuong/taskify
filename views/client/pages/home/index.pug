doctype html
html(class="scroll-smooth" lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title
    script(src="https://cdn.tailwindcss.com?plugins=forms,container-queries")
    link(href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet")
    link(href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet")
    script.
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "on-error": "#ffffff",
              "surface-dim": "#d9dadb",
              "error-container": "#ffdad6",
              "surface-tint": "#0053db",
              "surface": "#f8f9fa",
              "on-background": "#191c1d",
              "secondary": "#495c95",
              "inverse-surface": "#2e3132",
              "secondary-fixed": "#dbe1ff",
              "surface-variant": "#e1e3e4",
              "on-surface": "#191c1d",
              "tertiary": "#943700",
              "tertiary-fixed-dim": "#ffb596",
              "surface-container-highest": "#e1e3e4",
              "on-secondary": "#ffffff",
              "on-primary-container": "#eeefff",
              "secondary-container": "#acbfff",
              "inverse-on-surface": "#f0f1f2",
              "tertiary-fixed": "#ffdbcd",
              "on-surface-variant": "#434655",
              "background": "#f8f9fa",
              "tertiary-container": "#bc4800",
              "on-tertiary-container": "#ffede6",
              "error": "#ba1a1a",
              "on-tertiary-fixed-variant": "#7d2d00",
              "on-tertiary": "#ffffff",
              "on-primary-fixed": "#00174b",
              "surface-container-lowest": "#ffffff",
              "primary-container": "#2563eb",
              "surface-container": "#edeeef",
              "outline-variant": "#c3c6d7",
              "secondary-fixed-dim": "#b4c5ff",
              "primary-fixed": "#dbe1ff",
              "primary": "#004ac6",
              "on-error-container": "#93000a",
              "surface-container-high": "#e7e8e9",
              "on-tertiary-fixed": "#360f00",
              "on-primary": "#ffffff",
              "surface-container-low": "#f3f4f5",
              "primary-fixed-dim": "#b4c5ff",
              "on-primary-fixed-variant": "#003ea8",
              "outline": "#737686",
              "on-secondary-container": "#394c84",
              "surface-bright": "#f8f9fa",
              "inverse-primary": "#b4c5ff",
              "on-secondary-fixed-variant": "#31447b",
              "on-secondary-fixed": "#00174b"
            },
            fontFamily: {
              headline: ["Manrope", "sans-serif"],
              body: ["Inter", "sans-serif"],
              label: ["Inter", "sans-serif"]
            },
            borderRadius: {
              DEFAULT: "0.125rem",
              lg: "0.25rem",
              xl: "0.5rem",
              full: "0.75rem"
            }
          }
        }
      };
    style.
      body { font-family: 'Inter', sans-serif; }
      .font-headline { font-family: 'Manrope', sans-serif; }
      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      }
      .signature-gradient {
        background: linear-gradient(135deg, #004ac6 0%, #2563eb 100%);
      }
  body(class="bg-surface text-on-surface antialiased overflow-x-hidden")
    - const footerColumns = [{ title: 'Product', links: ['Features', 'Integrations', 'Pricing'] }, { title: 'Company', links: ['About Us', 'Contact Sales', 'Security'] }, { title: 'Legal', links: ['Privacy Policy', 'Terms of Service', 'Status'] }]
    nav(class="fixed top-0 w-full z-50 bg-white/80 backdrop-blur-xl shadow-sm")
      .flex.justify-between.items-center.w-full.px-6.py-4.max-w-7xl.mx-auto
        .flex.items-center.gap-12
          a(class="text-2xl font-black tracking-tighter text-blue-700" href="/") ProjX
          div(class="hidden md:flex items-center gap-8")
            a(class="text-blue-700 font-semibold border-b-2 border-blue-600 uppercase tracking-wider text-xs font-label" href="#features") Features
            a(class="text-slate-600 hover:text-blue-600 transition-colors uppercase tracking-wider text-xs font-label" href="#solutions") Solutions
            a(class="text-slate-600 hover:text-blue-600 transition-colors uppercase tracking-wider text-xs font-label" href="#pricing") Pricing
            a(class="text-slate-600 hover:text-blue-600 transition-colors uppercase tracking-wider text-xs font-label" href="#resources") Resources
        .flex.items-center.gap-4
          a(class="px-5 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50 transition-all duration-200 rounded-lg scale-95 active:scale-90" href="/login") Log In
          a(class="px-5 py-2.5 text-sm font-bold text-white signature-gradient rounded-full shadow-lg shadow-blue-600/20 transition-transform active:scale-95" href="/sign-up") Get Started Free
    main(class="pt-24")
      section(class="relative px-6 py-20 md:py-32 max-w-7xl mx-auto overflow-hidden")
        div(class="grid lg:grid-cols-2 gap-16 items-center")
          .z-10
            span(class="inline-block px-4 py-1.5 mb-6 text-xs font-bold tracking-widest uppercase bg-primary-fixed text-on-primary-fixed rounded-full") New: Version 4.0 is live
            h1(class="text-5xl md:text-7xl font-extrabold font-headline text-on-surface tracking-tight leading-[1.1] mb-8")
              | Unlock Team 
              span(class="text-primary") Productivity.
              |  Elevate Your Projects.
            p(class="text-xl text-on-surface-variant font-body leading-relaxed mb-10 max-w-lg") Organize, track, and collaborate with ease. Streamline your workflow from idea to delivery with the architectural precision of ProjX.
            div(class="flex flex-col sm:flex-row gap-4")
              a(class="px-8 py-4 text-lg font-bold text-white signature-gradient rounded-full shadow-xl shadow-blue-600/30 transition-all hover:scale-105 active:scale-95 text-center" href="/sign-up") Get Started for Free
              a(class="px-8 py-4 text-lg font-bold text-primary border-2 border-primary/20 hover:bg-primary/5 rounded-full transition-all active:scale-95 flex items-center justify-center gap-2" href="/login")
                span.material-symbols-outlined play_circle
                | Request a Demo
            .mt-12.flex.items-center.gap-6.grayscale.opacity-60
              each logo in ['A', 'B', 'C']
                .h-6.w-20.rounded.bg-slate-300.flex.items-center.justify-center.text-xs.font-bold.text-slate-600= logo
          .relative
            div(class="absolute -top-20 -right-20 w-96 h-96 bg-primary/10 rounded-full blur-3xl")
            div(class="absolute -bottom-20 -left-20 w-72 h-72 bg-secondary-container/20 rounded-full blur-3xl")
            div(class="relative bg-surface-container-lowest rounded-2xl p-4 shadow-2xl border border-outline-variant/15")
              div(class="rounded-xl w-full h-[420px] bg-gradient-to-br from-slate-50 to-slate-200 border border-slate-200 flex items-center justify-center text-slate-500 font-semibold") Dashboard Preview
              div(class="absolute -bottom-6 -right-6 md:-right-12 bg-white p-6 rounded-2xl shadow-xl max-w-xs border border-outline-variant/10")
                .flex.items-center.gap-3.mb-2
                  .w-2.h-2.rounded-full.bg-emerald-500
                  span(class="text-xs font-bold uppercase tracking-wider text-slate-500") Active Sprint
                p(class="text-sm font-semibold text-on-surface mb-3") Workspace Redesign Phase 1
                .w-full.bg-surface-container-low.h-2.rounded-full.overflow-hidden
                  div(class="bg-primary w-3/4 h-full")
      section#features(class="bg-surface-container-low py-24 px-6")
        .max-w-7xl.mx-auto
          .text-center.mb-16
            h2(class="text-3xl md:text-4xl font-extrabold font-headline mb-4") Precision-Engineered Features
            p(class="text-on-surface-variant max-w-2xl mx-auto") Built for teams that value clarity and speed. Our tools adapt to your workflow, not the other way around.
          div(class="grid md:grid-cols-3 gap-8")
            div(class="bg-surface-container-lowest p-8 rounded-xl shadow-sm hover:shadow-xl transition-all group border border-transparent hover:border-primary/10")
              div(class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-6 group-hover:scale-110 transition-transform")
                span.material-symbols-outlined view_kanban
              h3(class="text-xl font-bold font-headline mb-3") Visualize Workflow
              p(class="text-on-surface-variant mb-8 text-sm leading-relaxed") Master your tasks with our intuitive Kanban boards. Drag, drop, and deploy with effortless precision.
              .flex.gap-2
                .flex-1.space-y-2
                  div(class="h-12 bg-surface-container-low rounded-md border-l-4 border-primary/40")
                  div(class="h-10 bg-surface-container-low rounded-md opacity-60")
                .flex-1.space-y-2
                  div(class="h-10 bg-surface-container-low rounded-md")
                  div(class="h-14 bg-surface-container-low rounded-md border-l-4 border-primary/40")
                .flex-1.space-y-2
                  div(class="h-8 bg-surface-container-low rounded-md opacity-40")
            div(class="bg-surface-container-lowest p-8 rounded-xl shadow-sm hover:shadow-xl transition-all group border border-transparent hover:border-primary/10")
              div(class="w-12 h-12 bg-secondary-container/30 rounded-lg flex items-center justify-center text-secondary mb-6 group-hover:scale-110 transition-transform")
                span.material-symbols-outlined bar_chart
              h3(class="text-xl font-bold font-headline mb-3") Real-time Collaboration & Analytics
              p(class="text-on-surface-variant mb-8 text-sm leading-relaxed") Stay informed with live updates and deep insights. Measure velocity and project health in one click.
              .flex.items-end.gap-2.h-24
                div(class="w-1/4 bg-primary/20 h-12 rounded-t-sm")
                div(class="w-1/4 bg-primary/40 h-20 rounded-t-sm")
                div(class="w-1/4 bg-primary/60 h-16 rounded-t-sm")
                div(class="w-1/4 bg-primary h-24 rounded-t-sm")
            div(class="bg-surface-container-lowest p-8 rounded-xl shadow-sm hover:shadow-xl transition-all group border border-transparent hover:border-primary/10")
              div(class="w-12 h-12 bg-tertiary-container/10 rounded-lg flex items-center justify-center text-tertiary mb-6 group-hover:scale-110 transition-transform")
                span.material-symbols-outlined lock
              h3(class="text-xl font-bold font-headline mb-3") Secure Permissions & Control
              p(class="text-on-surface-variant mb-8 text-sm leading-relaxed") Granular access control to keep your data safe. Manage roles, guests, and internal privacy effortlessly.
              .relative.h-24.flex.items-center.justify-center.bg-surface-container-low.rounded-lg
                span(class="material-symbols-outlined text-4xl text-on-surface/20") security
                .absolute.inset-0.flex.items-center.justify-center
                  .w-12.h-12.bg-white.rounded-full.shadow-lg.flex.items-center.justify-center
                    span(class="material-symbols-outlined text-primary") key
      section#solutions(class="py-24 px-6 bg-surface")
        div(class="max-w-6xl mx-auto bg-surface-container-lowest rounded-3xl overflow-hidden shadow-2xl border border-outline-variant/5")
          div(class="grid lg:grid-cols-2")
            div(class="p-12 md:p-16 signature-gradient text-white flex flex-col justify-center")
              h2(class="text-3xl md:text-4xl font-extrabold font-headline mb-8") Guest - Experience ProjX
              ul(class="space-y-6")
                each benefit in [{title: 'Unlimited Public Workspaces', desc: 'Perfect for open-source and community-driven projects.'}, {title: 'Real-time Activity Stream', desc: 'See updates as they happen across all your guest boards.'}, {title: 'Mobile App Syncing', desc: 'Take your work on the go with our top-rated iOS and Android apps.'}]
                  li(class="flex items-start gap-4")
                    div(class="mt-1 flex-shrink-0 w-6 h-6 rounded-full bg-white/20 flex items-center justify-center")
                      span(class="material-symbols-outlined text-xs") check
                    div
                      h4(class="font-bold text-lg")= benefit.title
                      p(class="text-white/70 text-sm")= benefit.desc
            div(class="p-12 md:p-16 flex flex-col justify-center")
              .mb-8
                h3(class="text-2xl font-bold text-on-surface mb-2") Create Your Account
                p(class="text-on-surface-variant") Start your 14-day premium trial. No credit card required.
              form(class="space-y-4" method="GET" action="/sign-up")
                div
                  label(class="block text-xs font-bold uppercase tracking-widest text-on-surface-variant mb-2 font-label") Work Email
                  input(class="w-full bg-surface-container-low border-none rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary transition-all" placeholder="name@company.com" type="email" disabled)
                div
                  label(class="block text-xs font-bold uppercase tracking-widest text-on-surface-variant mb-2 font-label") Password
                  input(class="w-full bg-surface-container-low border-none rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary transition-all" placeholder="Min. 8 characters" type="password" disabled)
                button(class="w-full py-4 bg-primary text-white font-bold rounded-xl shadow-lg hover:shadow-primary/20 transition-all active:scale-[0.98] mt-4" type="submit") Get Started
              div(class="mt-8 pt-8 border-t border-outline-variant/20 text-center")
                p(class="text-on-surface-variant text-sm")
                  | Already have an account? 
                  a(class="text-primary font-bold hover:underline" href="/login") Login
    footer(class="w-full border-t border-slate-200/15 bg-slate-50")
      div(class="grid grid-cols-1 md:grid-cols-2 gap-8 w-full px-8 py-12 max-w-7xl mx-auto")
        .space-y-6
          .text-xl.font-bold.text-slate-900 ProjX
          p(class="text-slate-500 max-w-sm text-sm font-body") The architectural workspace for modern teams. Building the future of project management with precision and editorial elegance.
          .flex.gap-4
            each icon in ['public', 'terminal']
              a(class="w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center text-slate-600 hover:text-blue-600 transition-colors" href="#")
                span(class="material-symbols-outlined text-sm")= icon
        div(class="grid grid-cols-2 sm:grid-cols-3 gap-8")
          each column in footerColumns
            div
              span(class="block text-xs font-bold uppercase tracking-widest text-slate-900 mb-4 font-label")= column.title
              ul(class="space-y-3")
                each linkText in column.links
                  li
                    a(class="text-slate-500 hover:text-blue-600 text-sm transition-opacity opacity-80 hover:opacity-100 underline-offset-4 hover:underline" href="#")= linkText
        div(class="md:col-span-2 pt-8 border-t border-slate-200 flex flex-col md:flex-row justify-between items-center gap-4")
          p(class="text-slate-500 text-xs") © 2024 ProjX Architectural Workspace. All rights reserved.
          .flex.items-center.gap-6
            span(class="flex items-center gap-2 text-xs font-bold text-slate-900")
              .w-2.h-2.rounded-full.bg-emerald-500
              | All Systems Operational
