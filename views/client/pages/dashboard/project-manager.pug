doctype html
html(class="light" lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title
    script(src="https://cdn.tailwindcss.com?plugins=forms,container-queries")
    link(href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet")
    link(href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet")
    script.
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "on-primary-fixed": "#00174b",
              "error": "#ba1a1a",
              "tertiary-fixed": "#ffdbcd",
              "inverse-surface": "#2e3132",
              "secondary-fixed": "#dbe1ff",
              "on-primary-fixed-variant": "#003ea8",
              "on-tertiary-fixed": "#360f00",
              "on-primary": "#ffffff",
              "surface": "#f8f9fa",
              "surface-container-lowest": "#ffffff",
              "on-secondary-fixed-variant": "#31447b",
              "on-secondary": "#ffffff",
              "secondary": "#495c95",
              "on-primary-container": "#eeefff",
              "surface-variant": "#e1e3e4",
              "outline-variant": "#c3c6d7",
              "on-error": "#ffffff",
              "surface-container-highest": "#e1e3e4",
              "on-secondary-container": "#394c84",
              "secondary-container": "#acbfff",
              "on-tertiary": "#ffffff",
              "on-secondary-fixed": "#00174b",
              "surface-container-low": "#f3f4f5",
              "error-container": "#ffdad6",
              "primary-fixed": "#dbe1ff",
              "surface-bright": "#f8f9fa",
              "on-tertiary-container": "#ffede6",
              "on-surface": "#191c1d",
              "secondary-fixed-dim": "#b4c5ff",
              "on-surface-variant": "#434655",
              "on-error-container": "#93000a",
              "background": "#f8f9fa",
              "tertiary-container": "#bc4800",
              "surface-container": "#edeeef",
              "outline": "#737686",
              "tertiary": "#943700",
              "surface-container-high": "#e7e8e9",
              "primary": "#004ac6",
              "tertiary-fixed-dim": "#ffb596",
              "inverse-on-surface": "#f0f1f2",
              "inverse-primary": "#b4c5ff",
              "surface-tint": "#0053db",
              "on-background": "#191c1d",
              "surface-dim": "#d9dadb",
              "primary-fixed-dim": "#b4c5ff",
              "primary-container": "#2563eb",
              "on-tertiary-fixed-variant": "#7d2d00"
            },
            fontFamily: {
              headline: ["Manrope"],
              body: ["Inter"],
              label: ["Inter"]
            },
            borderRadius: {
              DEFAULT: "0.125rem",
              lg: "0.25rem",
              xl: "0.5rem",
              full: "0.75rem"
            }
          }
        }
      }
    style.
      body { font-family: 'Inter', sans-serif; }
      h1, h2, h3, .font-headline { font-family: 'Manrope', sans-serif; }
      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      }
  body(class="bg-surface text-on-surface flex min-h-screen")
    - const displayName = (user && (user.full_name || user.email)) || 'Alex Morgan'
    - const avatarText = (displayName || 'A').trim().charAt(0).toUpperCase()
    - const projects = [{ code: 'NS', color: 'bg-blue-100 text-primary', name: 'Nexus System Upgrade', lead: 'Sarah Kim', progress: 85, status: 'On Track', statusClass: 'bg-green-100 text-green-700' }, { code: 'MB', color: 'bg-amber-100 text-amber-700', name: 'Mobile App Beta', lead: 'John Doe', progress: 42, status: 'Delayed', statusClass: 'bg-red-100 text-red-700' }, { code: 'CP', color: 'bg-emerald-100 text-emerald-700', name: 'Client Portal v2', lead: 'Lisa Ray', progress: 60, status: 'On Track', statusClass: 'bg-green-100 text-green-700' }, { code: 'AI', color: 'bg-purple-100 text-purple-700', name: 'AI Integration Phase', lead: 'Mike Jones', progress: 15, status: 'Planning', statusClass: 'bg-slate-100 text-slate-700' }]
    - const teams = [{ name: 'Frontend Team', color: 'bg-primary', usage: '14 / 16' }, { name: 'Backend Team', color: 'bg-secondary', usage: '12 / 12' }, { name: 'Marketing', color: 'bg-tertiary-container', usage: '6 / 8' }]
    - const milestones = [{ date: 'June 18', title: 'Design Review', project: 'Nexus System', border: 'border-primary', text: 'text-primary' }, { date: 'June 20', title: 'Alpha Release', project: 'Mobile App Beta', border: 'border-error', text: 'text-error' }, { date: 'June 21', title: 'QA Completion', project: 'Client Portal v2', border: 'border-secondary', text: 'text-secondary' }, { date: 'June 24', title: 'Sprint Planning', project: 'AI Integration', border: 'border-tertiary', text: 'text-tertiary' }]
    - const systemUsers = users || []
    - const roleLabels = { project_manager: 'Project Manager', team_leader: 'Team Leader', member: 'Member' }
    - const roleUpdateMessages = { success: { text: 'Role updated successfully.', className: 'bg-green-50 text-green-700 border-green-200' }, invalid: { text: 'Invalid role selection.', className: 'bg-red-50 text-red-700 border-red-200' }, not_found: { text: 'User not found.', className: 'bg-red-50 text-red-700 border-red-200' }, self_locked: { text: 'Project Manager cannot change their own role here.', className: 'bg-amber-50 text-amber-700 border-amber-200' }, pm_locked: { text: 'Project Manager role is locked.', className: 'bg-amber-50 text-amber-700 border-amber-200' }, error: { text: 'Failed to update role. Check server/database connection.', className: 'bg-red-50 text-red-700 border-red-200' } }
    - const roleUpdateNotice = roleUpdateMessages[roleUpdateStatus]
    aside(class="fixed left-0 top-0 h-full w-64 bg-slate-100 dark:bg-slate-900 flex flex-col p-6 z-50")
      .mb-10
        span(class="text-xl font-bold tracking-tight text-slate-900 dark:text-slate-50") NexusDesk
      nav(class="flex-1 space-y-2")
        a(class="flex items-center gap-3 bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 rounded-full px-4 py-2 font-semibold transition-transform scale-95" href="/pm/dashboard")
          span.material-symbols-outlined dashboard
          span(class="text-[0.875rem] uppercase tracking-[0.05em]") Dashboard
        a(class="flex items-center gap-3 text-slate-600 dark:text-slate-400 px-4 py-2 hover:bg-slate-200/50 dark:hover:bg-slate-800/50 hover:text-slate-900 dark:hover:text-slate-200 transition-all duration-200" href="#")
          span.material-symbols-outlined folder_special
          span(class="text-[0.875rem] uppercase tracking-[0.05em]") Portfolios
        a(class="flex items-center gap-3 text-slate-600 dark:text-slate-400 px-4 py-2 hover:bg-slate-200/50 dark:hover:bg-slate-800/50 hover:text-slate-900 dark:hover:text-slate-200 transition-all duration-200" href="#")
          span.material-symbols-outlined groups
          span(class="text-[0.875rem] uppercase tracking-[0.05em]") Teams
        a(class="flex items-center gap-3 text-slate-600 dark:text-slate-400 px-4 py-2 hover:bg-slate-200/50 dark:hover:bg-slate-800/50 hover:text-slate-900 dark:hover:text-slate-200 transition-all duration-200" href="#")
          span.material-symbols-outlined bar_chart
          span(class="text-[0.875rem] uppercase tracking-[0.05em]") Reports
        a(class="flex items-center gap-3 text-slate-600 dark:text-slate-400 px-4 py-2 hover:bg-slate-200/50 dark:hover:bg-slate-800/50 hover:text-slate-900 dark:hover:text-slate-200 transition-all duration-200" href="#")
          span.material-symbols-outlined settings
          span(class="text-[0.875rem] uppercase tracking-[0.05em]") Settings
      div(class="mt-auto pt-6 border-t border-slate-200 dark:border-slate-800")
        button(class="w-full bg-gradient-to-br from-primary to-primary-container text-white py-3 rounded-full font-semibold text-sm shadow-md hover:shadow-lg transition-all active:scale-95") New Project
        .flex.items-center.gap-3.mt-8.px-2
          .w-10.h-10.rounded-full.bg-primary.text-white.flex.items-center.justify-center.font-semibold= avatarText
          div
            p(class="text-sm font-bold text-on-surface")= displayName
            p(class="text-xs text-on-surface-variant") Project Manager
    main(class="flex-1 ml-64 min-h-screen")
      header(class="sticky top-0 w-full z-40 bg-white/80 dark:bg-slate-950/80 backdrop-blur-md h-16 px-8 flex justify-between items-center shadow-sm dark:shadow-none border-b border-slate-200/15 dark:border-slate-800/15")
        .flex.items-center.gap-4.flex-1
          .relative.w-96.max-w-full
            span(class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-xl") search
            input(class="w-full bg-surface-container-low border-none rounded-full py-2 pl-10 pr-4 text-sm focus:ring-2 focus:ring-primary/20 transition-all" placeholder="Search projects, tasks, or files..." type="text")
        .flex.items-center.gap-6
          button(class="text-slate-500 hover:text-blue-700 transition-colors flex items-center gap-1 font-medium text-sm") Feedback
          .flex.items-center.gap-4
            span(class="material-symbols-outlined text-outline cursor-pointer hover:text-primary transition-colors") notifications
            span(class="material-symbols-outlined text-outline cursor-pointer hover:text-primary transition-colors") help_outline
          a(class="w-8 h-8 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center text-xs font-bold" href="/logout")= avatarText
      div(class="p-8 max-w-[1600px] mx-auto space-y-8")
        if roleUpdateNotice
          div(class=`rounded-xl border px-4 py-3 text-sm font-semibold ${roleUpdateNotice.className}`)= roleUpdateNotice.text
        .flex.justify-between.items-end
          div
            h1(class="text-[2rem] font-medium tracking-[-0.02em] text-on-surface font-headline") Architectural Workspace
            p(class="text-on-surface-variant mt-1") Real-time overview of your global project portfolio.
          .flex.gap-3
            button(class="px-4 py-2 bg-surface-container-low text-on-surface font-semibold rounded-full border border-outline-variant/30 hover:bg-surface-container-high transition-colors text-sm") Download Report
            button(class="px-4 py-2 bg-primary text-white font-semibold rounded-full hover:bg-primary-container transition-colors text-sm shadow-sm") View Archive
        div(class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6")
          div(class="bg-surface-container-lowest p-6 rounded-xl shadow-sm border border-outline-variant/10")
            .flex.justify-between.items-start.mb-4
              div(class="p-2 bg-primary/10 rounded-lg")
                span.material-symbols-outlined.text-primary work
              span(class="text-xs font-bold text-green-600 bg-green-50 px-2 py-1 rounded-full") +12% vs last month
            p(class="text-[0.75rem] uppercase tracking-[0.05em] text-on-surface-variant font-label mb-1") Total Active Projects
            h3(class="text-3xl font-bold font-headline") 12
          div(class="bg-surface-container-lowest p-6 rounded-xl shadow-sm border border-outline-variant/10")
            .flex.justify-between.items-center.mb-4
              div(class="p-2 bg-secondary-container/20 rounded-lg")
                span.material-symbols-outlined.text-secondary donut_large
              .relative.w-10.h-10
                svg(class="w-full h-full transform -rotate-90")
                  circle(class="text-surface-container-high" cx="20" cy="20" fill="transparent" r="16" stroke="currentColor" stroke-width="4")
                  circle(class="text-primary" cx="20" cy="20" fill="transparent" r="16" stroke="currentColor" stroke-dasharray="100" stroke-dashoffset="32" stroke-width="4")
            p(class="text-[0.75rem] uppercase tracking-[0.05em] text-on-surface-variant font-label mb-1") Overall Progress
            h3(class="text-3xl font-bold font-headline") 68%
          div(class="bg-surface-container-lowest p-6 rounded-xl shadow-sm border border-outline-variant/10")
            .flex.justify-between.items-start.mb-4
              div(class="p-2 bg-error-container/20 rounded-lg")
                span.material-symbols-outlined.text-error warning
              span(class="text-xs font-bold text-error bg-error-container/30 px-2 py-1 rounded-full") High Priority
            p(class="text-[0.75rem] uppercase tracking-[0.05em] text-on-surface-variant font-label mb-1") At Risk
            h3(class="text-3xl font-bold font-headline text-error") 5 Projects
          div(class="bg-surface-container-lowest p-6 rounded-xl shadow-sm border border-outline-variant/10")
            .flex.justify-between.items-start.mb-4
              div(class="p-2 bg-tertiary-fixed-dim/20 rounded-lg")
                span.material-symbols-outlined.text-tertiary groups
              span(class="text-xs font-bold text-on-surface-variant bg-surface-container-low px-2 py-1 rounded-full") Optimal Load
            p(class="text-[0.75rem] uppercase tracking-[0.05em] text-on-surface-variant font-label mb-1") Total Resources
            h3(class="text-3xl font-bold font-headline") 4 Teams
              span(class="text-lg font-medium text-outline")  / 32 Members
        div(class="grid grid-cols-1 lg:grid-cols-3 gap-8")
          div(class="lg:col-span-2 space-y-6")
            div(class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden border border-outline-variant/10")
              div(class="p-6 flex justify-between items-center bg-surface-container-low/50")
                h2(class="text-xl font-bold font-headline") Project Portfolio Overview
                button(class="text-primary text-sm font-semibold hover:underline") View All Projects
              .p-6
                table(class="w-full text-left")
                  thead
                    tr(class="border-b border-outline-variant/20")
                      th(class="pb-4 text-[0.75rem] uppercase tracking-[0.05em] text-on-surface-variant font-label") Project Name
                      th(class="pb-4 text-[0.75rem] uppercase tracking-[0.05em] text-on-surface-variant font-label") Team Lead
                      th(class="pb-4 text-[0.75rem] uppercase tracking-[0.05em] text-on-surface-variant font-label") Progress
                      th(class="pb-4 text-[0.75rem] uppercase tracking-[0.05em] text-on-surface-variant font-label") Status
                  tbody(class="divide-y divide-outline-variant/10")
                    each project in projects
                      tr(class="group hover:bg-surface-container-low/30 transition-colors")
                        td(class="py-5")
                          .flex.items-center.gap-3
                            div(class=`w-10 h-10 rounded-lg flex items-center justify-center font-bold ${project.color}`)= project.code
                            span(class="font-semibold text-on-surface")= project.name
                        td(class="py-5")
                          .flex.items-center.gap-2
                            .w-8.h-8.rounded-full.bg-slate-200.text-slate-700.flex.items-center.justify-center.text-xs.font-bold= project.lead.charAt(0)
                            span(class="text-sm text-on-surface-variant")= project.lead
                        td(class="py-5")
                          .w-32
                            .flex.justify-between.mb-1
                              span(class="text-[10px] font-bold text-on-surface-variant") #{project.progress}%
                            div(class="h-1.5 w-full bg-surface-container-high rounded-full overflow-hidden")
                              .h-full.bg-primary(style=`width:${project.progress}%`)
                        td(class="py-5")
                          span(class=`px-3 py-1 rounded-full text-xs font-bold ${project.statusClass}`)= project.status
          div(class="lg:col-span-1")
            div(class="bg-surface-container-lowest rounded-xl shadow-sm h-full border border-outline-variant/10 p-6 flex flex-col")
              .flex.justify-between.items-center.mb-8
                h2(class="text-xl font-bold font-headline") Resource Allocation
                span(class="material-symbols-outlined text-outline cursor-pointer") more_vert
              div(class="relative flex-1 flex items-center justify-center min-h-[250px] mb-8")
                svg(class="w-48 h-48 transform -rotate-90")
                  circle(class="text-primary" cx="96" cy="96" fill="transparent" r="76" stroke="currentColor" stroke-dasharray="477" stroke-dashoffset="190" stroke-width="20")
                  circle(class="text-secondary" cx="96" cy="96" fill="transparent" r="76" stroke="currentColor" stroke-dasharray="477" stroke-dashoffset="333" stroke-width="20")
                  circle(class="text-tertiary-container" cx="96" cy="96" fill="transparent" r="76" stroke="currentColor" stroke-dasharray="477" stroke-dashoffset="429" stroke-width="20")
                .absolute.inset-0.flex.flex-col.items-center.justify-center
                  span(class="text-3xl font-extrabold font-headline") 92%
                  span(class="text-[10px] uppercase tracking-widest text-on-surface-variant font-label") Utilization
              .space-y-4
                each team in teams
                  .flex.items-center.justify-between.p-3.rounded-lg.bg-surface-container-low
                    .flex.items-center.gap-3
                      span(class=`w-3 h-3 rounded-full ${team.color}`)
                      span(class="text-sm font-semibold")= team.name
                    span(class="text-sm font-bold")= team.usage
              .mt-8
                button(class="w-full py-2 border border-outline-variant/50 rounded-lg text-sm font-semibold hover:bg-surface-container-low transition-colors") Manage Assignments
        div(class="grid grid-cols-1 md:grid-cols-4 gap-6")
          div(class="md:col-span-1 bg-gradient-to-br from-primary-container to-primary p-6 rounded-xl text-white shadow-lg")
            h4(class="text-lg font-bold font-headline mb-4") Productivity Pulse
            p(class="text-sm opacity-80 mb-6") Your team completed 24% more tasks this week than last.
            .flex.gap-1.items-end.h-16
              each height, index in ['40%', '60%', '50%', '80%', '95%']
                .flex-1.bg-white.rounded-t(style=`height:${height};opacity:${index === 4 ? 0.6 : index === 2 ? 0.4 : 0.2}`)
          div(class="md:col-span-3 bg-surface-container-lowest p-6 rounded-xl shadow-sm border border-outline-variant/10")
            .flex.justify-between.items-center.mb-6
              h4(class="text-lg font-bold font-headline") Upcoming Milestones
              span(class="text-xs text-on-surface-variant font-medium") Next 7 Days
            .flex.gap-4.overflow-x-auto.pb-2
              each milestone in milestones
                div(class=`min-w-[200px] p-4 rounded-lg bg-surface-container-low border-l-4 ${milestone.border}`)
                  p(class=`text-[10px] font-bold uppercase mb-1 ${milestone.text}`)= milestone.date
                  p(class="font-bold text-sm")= milestone.title
                  p(class="text-xs text-on-surface-variant")= milestone.project
        div(class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/10 overflow-hidden")
          div(class="p-6 flex items-center justify-between bg-surface-container-low/50")
            div
              h2(class="text-xl font-bold font-headline") User Role Management
              p(class="text-sm text-on-surface-variant mt-1") Project Manager co the doi role cua user sang Team Leader hoac Member.
            span(class="text-sm font-semibold text-primary") #{systemUsers.length} users
          .p-6
            if systemUsers.length
              .overflow-x-auto
                table(class="w-full text-left")
                  thead
                    tr(class="border-b border-outline-variant/20")
                      th(class="pb-4 text-[0.75rem] uppercase tracking-[0.05em] text-on-surface-variant font-label") User
                      th(class="pb-4 text-[0.75rem] uppercase tracking-[0.05em] text-on-surface-variant font-label") Email
                      th(class="pb-4 text-[0.75rem] uppercase tracking-[0.05em] text-on-surface-variant font-label") Current Role
                      th(class="pb-4 text-[0.75rem] uppercase tracking-[0.05em] text-on-surface-variant font-label") Change Role
                  tbody(class="divide-y divide-outline-variant/10")
                    each item in systemUsers
                      tr(class="align-middle")
                        td(class="py-4")
                          .flex.items-center.gap-3
                            .w-10.h-10.rounded-full.bg-slate-200.text-slate-700.flex.items-center.justify-center.font-bold= ((item.full_name || item.email || 'U').trim().charAt(0).toUpperCase())
                            div
                              p(class="font-semibold text-on-surface")= item.full_name || 'No name'
                              if user && item.id === user.id
                                p(class="text-xs text-primary font-semibold") Current session
                        td(class="py-4 text-sm text-on-surface-variant")= item.email
                        td(class="py-4")
                          span(class=`inline-flex rounded-full px-3 py-1 text-xs font-bold ${item.normalizedRole === 'project_manager' ? 'bg-blue-100 text-blue-700' : item.normalizedRole === 'team_leader' ? 'bg-amber-100 text-amber-700' : 'bg-slate-100 text-slate-700'}`)= roleLabels[item.normalizedRole] || item.role
                        td(class="py-4")
                          if item.canEditRole
                            form(method="POST" action=`/pm/users/${item.id}/role` class="flex items-center gap-3")
                              select(name="role" class="rounded-lg border border-outline-variant/40 bg-white px-3 py-2 text-sm focus:border-primary focus:outline-none")
                                each roleOption in roleOptions
                                  option(value=roleOption selected=item.normalizedRole === roleOption)= roleLabels[roleOption]
                              button(type="submit" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white hover:bg-primary-container") Save
                          else
                            span(class="text-sm font-semibold text-slate-400") Locked
            else
              p(class="text-sm text-on-surface-variant") Chua co user nao trong he thong.
