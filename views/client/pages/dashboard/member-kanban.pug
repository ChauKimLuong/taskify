doctype html
html(lang="vi")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title
    script(src="https://cdn.tailwindcss.com?plugins=forms")
    link(href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet")
    style.
      body { font-family: 'Public Sans', sans-serif; }
  body(class="bg-slate-50 text-slate-900 min-h-screen")
    - const displayName = (user && (user.full_name || user.email)) || 'Member'
    - const avatarText = (displayName || 'M').trim().charAt(0).toUpperCase()
    .max-w-7xl.mx-auto.px-6.py-8
      .flex.items-center.justify-between.mb-8
        div
          h1(class="text-3xl font-extrabold tracking-tight") Member Kanban
          p(class="text-slate-500 mt-1") Trang tạm cho member. Tôi đã gắn sẵn route theo role để bạn gửi UI kanban sau.
        .flex.items-center.gap-3
          .w-10.h-10.rounded-full.bg-blue-600.text-white.flex.items-center.justify-center.font-bold= avatarText
          a(class="px-4 py-2 rounded-lg border border-slate-300 bg-white text-sm font-semibold hover:bg-slate-100" href="/logout") Đăng xuất
      div(class="grid grid-cols-1 md:grid-cols-3 gap-6")
        each column in [{name: 'To Do', tasks: ['Chuẩn bị sprint note', 'Review task mới']}, {name: 'In Progress', tasks: ['Xây API login', 'Fix lỗi responsive']}, {name: 'Done', tasks: ['Cập nhật schema user']}]
          .bg-white.rounded-2xl.border.border-slate-200.p-5.shadow-sm
            h2(class="text-lg font-bold mb-4")= column.name
            .space-y-3
              each task in column.tasks
                .rounded-xl.border.border-slate-200.bg-slate-50.p-4
                  p(class="font-semibold")= task
