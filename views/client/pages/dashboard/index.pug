doctype html
html(lang="en" class="scroll-smooth")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title + ' | Taskify'
    script(src="https://cdn.tailwindcss.com?plugins=forms,container-queries")
    link(href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet")
    link(href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet")
    script.
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "primary-fixed-dim": "#b4c5ff",
              "surface-container-low": "#f3f4f5",
              "surface": "#f8f9fa",
              "surface-tint": "#0053db",
              "primary-container": "#2563eb",
              "primary-fixed": "#dbe1ff",
              "outline": "#737686",
              "error-container": "#ffdad6",
              "on-secondary": "#ffffff",
              "secondary-container": "#acbfff",
              "tertiary-container": "#bc4800",
              "inverse-surface": "#2e3132",
              "background": "#f8f9fa",
              "surface-container-highest": "#e1e3e4",
              "secondary": "#495c95",
              "on-primary": "#ffffff",
              "on-primary-container": "#eeefff",
              "tertiary": "#943700",
              "surface-dim": "#d9dadb",
              "surface-container-high": "#e7e8e9",
              "on-error": "#ffffff",
              "on-surface-variant": "#434655",
              "outline-variant": "#c3c6d7",
              "on-surface": "#191c1d",
              "primary": "#004ac6",
              "surface-container": "#edeeef",
              "surface-container-lowest": "#ffffff",
              "on-background": "#191c1d",
              "error": "#ba1a1a",
              "tertiary-fixed": "#ffdbcd",
              "on-tertiary-fixed": "#360f00"
            },
            fontFamily: {
              headline: ["Manrope", "sans-serif"],
              body: ["Inter", "sans-serif"],
              label: ["Inter", "sans-serif"]
            },
            borderRadius: { DEFAULT: "0.125rem", lg: "0.25rem", xl: "0.5rem", full: "0.75rem" }
          }
        }
      };
    style.
      body { font-family: 'Inter', sans-serif; }
      h1, h2, h3 { font-family: 'Manrope', sans-serif; }
      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      }

  body(class="bg-surface text-on-surface min-h-screen")

    //- ===== SIDEBAR =====
    aside(class="fixed h-screen w-64 left-0 top-0 flex flex-col p-6 gap-4 bg-surface-container-low z-50")
      .mb-4
        a(href="/dashboard" class="text-xl font-bold tracking-tight text-blue-700") Taskify

      //- User profile
      .flex.items-center.gap-3.mb-6.p-2
        if user.avatar_url
          img(src=user.avatar_url alt=user.full_name class="w-10 h-10 rounded-full object-cover")
        else
          .w-10.h-10.rounded-full.bg-primary.flex.items-center.justify-center.text-white.font-bold.text-sm= user.full_name ? user.full_name.charAt(0).toUpperCase() : user.email.charAt(0).toUpperCase()
        .flex.flex-col.overflow-hidden
          span.font-semibold.text-sm.truncate= user.full_name || user.email
          span(class="text-xs text-on-surface-variant")= user.email

      //- Create project button
      a(href="/projects/create" class="bg-gradient-to-br from-primary to-primary-container text-white px-4 py-2.5 rounded-xl font-medium text-sm flex items-center justify-center gap-2 hover:scale-95 transition-transform duration-150 mb-4 shadow-md shadow-primary/20")
        span(class="material-symbols-outlined text-sm") add
        | Create New Project

      //- Navigation
      nav.flex-1.space-y-1
        a(href="/dashboard" class="flex items-center gap-3 p-3 bg-blue-100 text-blue-800 rounded-full font-semibold group")
          span.material-symbols-outlined dashboard
          span(class="uppercase tracking-[0.05em] text-[0.75rem]") Dashboard

      //- Footer
      div(class="pt-6 border-t border-outline-variant/15 flex flex-col gap-1")
        a(href="/logout" class="flex items-center gap-3 p-3 text-slate-600 font-medium hover:bg-slate-200 transition-colors duration-200 rounded-full group")
          span(class="material-symbols-outlined text-slate-500") logout
          span(class="uppercase tracking-[0.05em] text-[0.75rem]") Logout

    //- ===== MAIN CONTENT =====
    main(class="ml-64 p-8 min-h-screen")

      //- Welcome header
      .mb-10
        h1(class="text-3xl font-bold tracking-tight mb-2") Welcome back, #{user.full_name || user.email}!
        p(class="text-on-surface-variant") Manage your projects and track progress.

      //- Stats row
      .grid.grid-cols-3.gap-6.mb-10
        div(class="bg-surface-container-lowest rounded-2xl p-6 shadow-sm border border-outline-variant/10")
          .flex.items-center.gap-4
            div(class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center")
              span(class="material-symbols-outlined text-primary") folder_open
            div
              p(class="text-2xl font-bold")= projects.length
              p(class="text-xs text-on-surface-variant uppercase tracking-wider font-medium") Total Projects

        div(class="bg-surface-container-lowest rounded-2xl p-6 shadow-sm border border-outline-variant/10")
          .flex.items-center.gap-4
            div(class="w-12 h-12 rounded-xl bg-tertiary/10 flex items-center justify-center")
              span(class="material-symbols-outlined text-tertiary") star
            div
              - var leaderCount = projects.filter(p => p.role === 'team_leader').length
              p(class="text-2xl font-bold")= leaderCount
              p(class="text-xs text-on-surface-variant uppercase tracking-wider font-medium") As Team Leader

        div(class="bg-surface-container-lowest rounded-2xl p-6 shadow-sm border border-outline-variant/10")
          .flex.items-center.gap-4
            div(class="w-12 h-12 rounded-xl bg-secondary/10 flex items-center justify-center")
              span(class="material-symbols-outlined text-secondary") group
            div
              - var memberCount = projects.filter(p => p.role === 'member').length
              p(class="text-2xl font-bold")= memberCount
              p(class="text-xs text-on-surface-variant uppercase tracking-wider font-medium") As Member

      //- Projects section
      .flex.justify-between.items-center.mb-6
        h2(class="text-xl font-bold") Your Projects
        a(href="/projects/create" class="flex items-center gap-1 text-primary text-sm font-semibold hover:underline")
          span(class="material-symbols-outlined text-sm") add
          | New Project

      if projects.length === 0
        div(class="bg-surface-container-lowest rounded-2xl p-16 text-center border border-outline-variant/10")
          span(class="material-symbols-outlined text-6xl text-slate-300 mb-4") folder_off
          h3(class="text-lg font-semibold mb-2") No projects yet
          p(class="text-on-surface-variant mb-6") Create your first project to get started!
          a(href="/projects/create" class="inline-flex items-center gap-2 bg-gradient-to-r from-primary to-primary-container text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:scale-95 transition-transform")
            span(class="material-symbols-outlined text-sm") add
            | Create Project
      else
        div(class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6")
          each p in projects
            a(href=`/projects/${p.id}` class="bg-surface-container-lowest rounded-2xl p-6 shadow-sm border border-transparent hover:border-primary/10 hover:shadow-lg transition-all group")
              .flex.justify-between.items-start.mb-4
                .flex.items-center.gap-3
                  div(class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center group-hover:scale-110 transition-transform")
                    span(class="material-symbols-outlined text-primary") folder_open
                  div
                    h3(class="font-semibold text-on-surface group-hover:text-primary transition-colors")= p.project_name
                    span(class="text-xs text-on-surface-variant")= p.role === 'team_leader' ? 'Team Leader' : 'Member'
                span(class=`text-[10px] font-bold uppercase tracking-widest px-2 py-1 rounded ${p.status === 'active' ? 'bg-emerald-100 text-emerald-700' : p.status === 'completed' ? 'bg-blue-100 text-blue-700' : 'bg-slate-100 text-slate-500'}`)= p.status

              if p.description
                p(class="text-xs text-on-surface-variant line-clamp-2 mb-4")= p.description

              //- Progress bar
              .mb-4
                .flex.justify-between.text-xs.mb-1
                  span(class="text-on-surface-variant font-medium") Progress
                  span(class="font-semibold")= p.progress + '%'
                .w-full.bg-surface-container-low.h-2.rounded-full.overflow-hidden
                  div(class="bg-primary h-full rounded-full transition-all" style=`width: ${p.progress}%`)

              //- Member avatars & task count
              div(class="flex items-center justify-between pt-4 border-t border-outline-variant/10")
                .flex.-space-x-2
                  each m, i in p.members
                    if i < 3
                      if m.user.avatar_url
                        img(src=m.user.avatar_url class="w-6 h-6 rounded-full border border-white object-cover")
                      else
                        .w-6.h-6.rounded-full.bg-secondary.flex.items-center.justify-center.text-white.text-xs.font-bold.border.border-white= m.user.full_name ? m.user.full_name.charAt(0).toUpperCase() : m.user.email.charAt(0).toUpperCase()
                  if p.members.length > 3
                    .w-6.h-6.rounded-full.bg-primary-fixed.flex.items-center.justify-center.text-xs.font-bold.border.border-white= '+' + (p.members.length - 3)
                span(class="text-xs text-on-surface-variant")= p.totalTasks + ' tasks'
