doctype html
html(class="light" lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title
    script(src="https://cdn.tailwindcss.com?plugins=forms,container-queries")
    link(href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet")
    link(href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet")
    script.
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "on-primary-fixed": "#00174b",
              "error": "#ba1a1a",
              "tertiary-fixed": "#ffdbcd",
              "inverse-surface": "#2e3132",
              "secondary-fixed": "#dbe1ff",
              "on-primary-fixed-variant": "#003ea8",
              "on-tertiary-fixed": "#360f00",
              "on-primary": "#ffffff",
              "surface": "#f8f9fa",
              "surface-container-lowest": "#ffffff",
              "on-secondary-fixed-variant": "#31447b",
              "on-secondary": "#ffffff",
              "secondary": "#495c95",
              "on-primary-container": "#eeefff",
              "surface-variant": "#e1e3e4",
              "outline-variant": "#c3c6d7",
              "on-error": "#ffffff",
              "surface-container-highest": "#e1e3e4",
              "on-secondary-container": "#394c84",
              "secondary-container": "#acbfff",
              "on-tertiary": "#ffffff",
              "on-secondary-fixed": "#00174b",
              "surface-container-low": "#f3f4f5",
              "error-container": "#ffdad6",
              "primary-fixed": "#dbe1ff",
              "surface-bright": "#f8f9fa",
              "on-tertiary-container": "#ffede6",
              "on-surface": "#191c1d",
              "secondary-fixed-dim": "#b4c5ff",
              "on-surface-variant": "#434655",
              "on-error-container": "#93000a",
              "background": "#f8f9fa",
              "tertiary-container": "#bc4800",
              "surface-container": "#edeeef",
              "outline": "#737686",
              "tertiary": "#943700",
              "surface-container-high": "#e7e8e9",
              "primary": "#004ac6",
              "tertiary-fixed-dim": "#ffb596",
              "inverse-on-surface": "#f0f1f2",
              "inverse-primary": "#b4c5ff",
              "surface-tint": "#0053db",
              "on-background": "#191c1d",
              "surface-dim": "#d9dadb",
              "primary-fixed-dim": "#b4c5ff",
              "primary-container": "#2563eb",
              "on-tertiary-fixed-variant": "#7d2d00"
            },
            fontFamily: {
              headline: ["Manrope"],
              body: ["Inter"],
              label: ["Inter"]
            },
            borderRadius: {
              DEFAULT: "0.125rem",
              lg: "0.25rem",
              xl: "0.5rem",
              full: "0.75rem"
            }
          }
        }
      }
    style.
      body { font-family: 'Inter', sans-serif; }
      h1, h2, h3 { font-family: 'Manrope', sans-serif; }
      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      }
  body(class="bg-surface text-on-surface")
    - const displayName = (user && (user.full_name || user.email)) || 'Team Leader'
    - const teamName = 'Frontend'
    - const avatarText = (displayName || 'T').trim().charAt(0).toUpperCase()
    - const members = [{ name: 'Sarah', load: '8 / 6 Tasks', width: '100%', barClass: 'bg-error', textClass: 'text-error' }, { name: 'Alex', load: '5 / 6 Tasks', width: '83%', barClass: 'bg-primary', textClass: 'text-outline' }, { name: 'John', load: '4 / 8 Tasks', width: '50%', barClass: 'bg-primary', textClass: 'text-outline' }, { name: 'Emily', load: '2 / 6 Tasks', width: '33%', barClass: 'bg-primary', textClass: 'text-outline' }]
    - const approvals = [{ member: 'Alex', task: 'API Authentication', project: 'Backend Refactor' }, { member: 'Sarah', task: 'User Profile UI', project: 'Frontend Core' }, { member: 'John', task: 'Database Sync', project: 'Infrastructure' }]
    - const activity = [{ icon: 'check', iconClass: 'bg-green-500', title: 'Alex', action: 'moved', target: 'Login API', suffix: 'Done', time: '2h ago' }, { icon: 'chat', iconClass: 'bg-amber-500', title: 'Sarah', action: 'commented on', target: 'UI Bug', suffix: '', time: '4h ago' }, { icon: 'assignment_ind', iconClass: 'bg-blue-600', title: 'You', action: 'assigned', target: 'Payment Gateway', suffix: 'John', time: 'Yesterday' }]
    aside(class="fixed left-0 top-0 h-full w-64 z-40 bg-slate-100 dark:bg-slate-900 flex flex-col p-6")
      .mb-10
        h1(class="text-xl font-bold tracking-tight text-slate-900 dark:text-slate-100") Architect
        p(class="text-[0.75rem] uppercase tracking-widest text-slate-500 mt-1") Workspace v2.4
      nav(class="flex-1 space-y-2")
        a(class="flex items-center gap-3 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full px-4 py-2 font-semibold transition-transform active:scale-95 duration-150" href="/team-leader/dashboard")
          span.material-symbols-outlined dashboard
          span(class="text-sm") Overview
        a(class="flex items-center gap-3 text-slate-600 dark:text-slate-400 px-4 py-2 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-200/50 dark:hover:bg-slate-800/50 transition-colors duration-200" href="#")
          span.material-symbols-outlined view_kanban
          span(class="text-sm") Kanban Board
        a(class="flex items-center gap-3 text-slate-600 dark:text-slate-400 px-4 py-2 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-200/50 dark:hover:bg-slate-800/50 transition-colors duration-200" href="#")
          span.material-symbols-outlined group
          span(class="text-sm") Members
        a(class="flex items-center gap-3 text-slate-600 dark:text-slate-400 px-4 py-2 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-200/50 dark:hover:bg-slate-800/50 transition-colors duration-200" href="#")
          span.material-symbols-outlined settings
          span(class="text-sm") Sprint Settings
      div(class="pt-6 border-t border-slate-200 dark:border-slate-800 space-y-2")
        .flex.items-center.gap-3.px-4.py-3.mb-4
          .w-10.h-10.rounded-full.bg-primary.text-white.flex.items-center.justify-center.font-semibold= avatarText
          div
            p(class="text-sm font-bold text-slate-900 dark:text-slate-100 leading-none")= displayName
            p(class="text-xs text-slate-500")= teamName
        a(class="flex items-center gap-3 text-slate-600 dark:text-slate-400 px-4 py-2 hover:text-slate-900 transition-colors" href="#")
          span.material-symbols-outlined help
          span(class="text-sm") Help
        a(class="flex items-center gap-3 text-slate-600 dark:text-slate-400 px-4 py-2 hover:text-slate-900 transition-colors" href="/logout")
          span.material-symbols-outlined logout
          span(class="text-sm") Sign Out
    main(class="pl-64 min-h-screen")
      header(class="flex justify-between items-center w-full px-8 py-4 bg-white dark:bg-slate-950 sticky top-0 z-30")
        .flex.items-center.gap-8
          h2(class="text-2xl font-extrabold tracking-tight text-on-surface") Overview
          nav(class="flex gap-6")
            a(class="text-slate-500 hover:text-slate-900 text-sm font-medium" href="#") Sprint 12
            a(class="text-blue-600 font-bold border-b-2 border-blue-600 text-sm" href="#") Sprint 13
            a(class="text-slate-500 hover:text-slate-900 text-sm font-medium" href="#") Sprint 14
        .flex.items-center.gap-4
          button(class="p-2 text-slate-500 hover:bg-slate-100 rounded-full transition-colors")
            span.material-symbols-outlined notifications
          button(class="bg-gradient-to-br from-primary to-primary-container text-white px-5 py-2.5 rounded-md font-semibold text-sm shadow-lg shadow-primary/20 hover:opacity-90 transition-opacity active:scale-95") Assign Task
      .p-8.space-y-8.max-w-7xl.mx-auto
        section(class="grid grid-cols-1 md:grid-cols-4 gap-6")
          .bg-surface-container-lowest.p-6.rounded-xl.shadow-sm.border.border-transparent
            .flex.justify-between.items-start.mb-4
              span(class="text-[0.75rem] font-label font-bold uppercase tracking-widest text-outline") Sprint Progress
              span(class="text-primary font-bold") 45%
            .h-3.w-full.bg-surface-container-high.rounded-full.overflow-hidden
              .h-full.bg-primary.rounded-full.transition-all.duration-1000(style="width:45%")
          .bg-surface-container-lowest.p-6.rounded-xl.shadow-sm.border.border-transparent
            .flex.items-center.gap-4
              .w-12.h-12.bg-amber-100.flex.items-center.justify-center.rounded-full.text-amber-500
                span.material-symbols-outlined check
              div
                p(class="text-2xl font-extrabold text-on-surface") 8 Tasks
                p(class="text-[0.75rem] font-label font-bold uppercase tracking-widest text-outline") To Review
          .bg-surface-container-lowest.p-6.rounded-xl.shadow-sm.border.border-transparent
            .flex.items-center.gap-4
              .w-12.h-12.bg-error-container.flex.items-center.justify-center.rounded-full.text-error
                span.material-symbols-outlined error
              div
                p(class="text-2xl font-extrabold text-on-surface") 3 Tasks
                p(class="text-[0.75rem] font-label font-bold uppercase tracking-widest text-error") Blocked / Overdue
          .bg-surface-container-lowest.p-6.rounded-xl.shadow-sm.border.border-transparent
            .flex.items-center.gap-4
              .w-12.h-12.bg-green-100.flex.items-center.justify-center.rounded-full.text-green-600
                span.material-symbols-outlined bolt
              div
                p(class="text-2xl font-extrabold text-on-surface") 85%
                p(class="text-[0.75rem] font-label font-bold uppercase tracking-widest text-outline") Team Capacity
        section(class="grid grid-cols-1 lg:grid-cols-12 gap-8")
          div(class="lg:col-span-7 bg-surface-container-lowest p-8 rounded-xl shadow-sm")
            .flex.justify-between.items-center.mb-8
              h3(class="text-xl font-bold tracking-tight") Member Workload
              span(class="text-xs font-semibold px-3 py-1 bg-surface-container rounded-full text-outline") Active Sprint
            .space-y-6
              each member in members
                .flex.items-center.gap-4
                  .w-10.h-10.rounded-full.bg-slate-200.text-slate-700.flex.items-center.justify-center.font-semibold= member.name.charAt(0)
                  .flex-1
                    .flex.justify-between.items-center.mb-1
                      span(class="font-semibold text-sm")= member.name
                      span(class=`text-xs font-medium ${member.textClass}`)= member.load
                    .h-2.w-full.bg-surface-container.rounded-full.overflow-hidden
                      .h-full.rounded-full(class=member.barClass style=`width:${member.width}`)
          div(class="lg:col-span-5 bg-surface-container-lowest p-8 rounded-xl shadow-sm")
            h3(class="text-xl font-bold tracking-tight mb-8") Pending Approvals
            .space-y-4
              each approval in approvals
                div(class="p-4 bg-surface-container-low rounded-xl transition-colors hover:bg-surface-container")
                  .flex.justify-between.items-start.mb-4
                    .flex.gap-3
                      .w-8.h-8.rounded-full.bg-slate-200.text-slate-700.flex.items-center.justify-center.text-xs.font-bold= approval.member.charAt(0)
                      div
                        p(class="font-bold text-sm")= approval.task
                        p(class="text-xs text-outline")= approval.project
                    span(class="material-symbols-outlined text-outline text-lg") open_in_new
                  .flex.gap-2
                    button(class="flex-1 py-1.5 text-xs font-bold bg-white text-on-surface border border-outline-variant rounded-md hover:bg-slate-50") Reject
                    button(class="flex-1 py-1.5 text-xs font-bold bg-primary text-white rounded-md hover:opacity-90") Approve
        section(class="bg-surface-container-lowest p-8 rounded-xl shadow-sm")
          .flex.items-center.gap-3.mb-8
            span(class="material-symbols-outlined text-primary") history
            h3(class="text-xl font-bold tracking-tight") Team Activity Log
          .space-y-4
            each item in activity
              .flex.items-start.gap-4.rounded-xl.bg-surface-container-low.p-4
                div(class=`w-10 h-10 rounded-full text-white flex items-center justify-center shrink-0 ${item.iconClass}`)
                  span(class="material-symbols-outlined text-sm")= item.icon
                .flex-1.flex.items-center.justify-between.gap-4
                  div(class="font-bold text-slate-900")
                    | #{item.title} 
                    span(class="font-normal text-slate-500")= item.action
                    |  #{item.target}
                    if item.suffix
                      span(class="font-normal text-slate-500")  to 
                      | #{item.suffix}
                  time(class="font-label font-bold text-[0.65rem] text-slate-400 uppercase tracking-widest")= item.time
