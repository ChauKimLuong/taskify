extends ../../layout

block title
  | #{title} | Taskify

block header-content
  .flex.items-center.gap-4.flex-1
    nav(class="flex items-center gap-2 text-xs font-medium text-slate-500")
      a(href="/dashboard" class="hover:text-primary cursor-pointer transition-colors") Dashboard
      span(class="material-symbols-outlined text-[14px]") chevron_right
      span(class="text-on-surface font-semibold") Create Project

block content
  .p-8.min-h-screen.flex.items-center.justify-center
    .w-full.max-w-xl.animate-fade-in-up

      //- Form card
      div(class="bg-surface-container-lowest rounded-2xl p-8 shadow-lg border border-outline-variant/10")
        .flex.items-center.gap-3.mb-8
          div(class="w-12 h-12 rounded-[10px] bg-primary/10 flex items-center justify-center")
            span(class="material-symbols-outlined text-primary text-2xl") create_new_folder
          div
            h1(class="text-2xl font-bold tracking-tight") Create New Project
            p(class="text-sm text-on-surface-variant") Set up a new workspace for your team

        form(method="POST" action="/projects/create")
          .space-y-6
            div
              label(class="block text-xs font-bold uppercase tracking-widest text-on-surface-variant mb-2") Project Name
              input(name="project_name" required class="w-full bg-surface-container-low border-none rounded-[10px] px-4 py-3 text-sm focus:ring-2 focus:ring-primary/40 transition-all placeholder:text-slate-400" placeholder="e.g. E-commerce Redesign")

            div
              label(class="block text-xs font-bold uppercase tracking-widest text-on-surface-variant mb-2") Description
              textarea(name="description" rows="4" class="w-full bg-surface-container-low border-none rounded-[10px] px-4 py-3 text-sm focus:ring-2 focus:ring-primary/40 resize-none transition-all placeholder:text-slate-400" placeholder="Describe your project goals and scope...")

            p(class="text-xs text-on-surface-variant bg-surface-container-low p-3 rounded-[10px] flex items-start gap-2")
              span(class="material-symbols-outlined text-sm mt-0.5 text-primary") info
              span You will be automatically assigned as the #[strong Team Leader] of this project.

            button(type="submit" class="w-full py-3.5 signature-gradient text-white font-semibold rounded-[10px] shadow-lg shadow-primary/20 hover:shadow-xl hover:shadow-primary/30 hover:opacity-95 transition-all duration-200 active:scale-[0.98]") Create Project
